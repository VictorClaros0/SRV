# Copiar a .env y ajustar valores en producción

# PostgreSQL (usuarios creados por Bitnami; mismo usuario para primary y standby)
POSTGRESQL_POSTGRES_PASSWORD=postgres_admin_secret
POSTGRESQL_USERNAME=votos
POSTGRESQL_PASSWORD=votos_db_secret
POSTGRESQL_DATABASE=votos

# Repmgr / réplica (debe coincidir en primary y standby)
REPMGR_PASSWORD=repmgr_secret

# Pgpool consola web / admin
PGPOOL_ADMIN_PASSWORD=pgpool_admin_secret

# Puertos en el host (Pgpool publicado para herramientas externas; la API usa pgpool por red Docker)
PGPOOL_HOST_PORT=5433
API_PORT=8080

# API
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
