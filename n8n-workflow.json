{
  "name": "Transcripcion de Actas SRV",
  "nodes": [
    {
      "id": "node-webhook",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "trigger-transcripcion",
        "responseMode": "responseNode"
      }
    },
    {
      "id": "node-get-actas",
      "name": "Obtener Actas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [470, 300],
      "parameters": {
        "method": "GET",
        "url": "http://api:8080/api/v1/actas/para-transcribir",
        "options": {}
      }
    },
    {
      "id": "node-split",
      "name": "Dividir Lista",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [690, 300],
      "parameters": {
        "jsCode": "const actas = $input.first().json;\nreturn actas.map(a => ({ json: a }));"
      }
    },
    {
      "id": "node-transcribir",
      "name": "Transcribir Acta",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [910, 300],
      "parameters": {
        "method": "POST",
        "url": "http://api:8080/webhook/n8n/transcripcion",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "string",
        "body": "={{ JSON.stringify($json) }}",
        "options": {}
      }
    },
    {
      "id": "node-respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1130, 300],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"success\":true,\"message\":\"Flujo de transcripcion ejecutado desde n8n\",\"estado\":\"EN_PROCESO\"}",
        "options": {
          "responseCode": 200
        }
      }
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [{"node": "Obtener Actas", "type": "main", "index": 0}]
      ]
    },
    "Obtener Actas": {
      "main": [
        [{"node": "Dividir Lista", "type": "main", "index": 0}]
      ]
    },
    "Dividir Lista": {
      "main": [
        [{"node": "Transcribir Acta", "type": "main", "index": 0}]
      ]
    },
    "Transcribir Acta": {
      "main": [
        [{"node": "Respond to Webhook", "type": "main", "index": 0}]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
